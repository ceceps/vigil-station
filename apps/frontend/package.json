{
  "name": "mission-planning-assistant-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend for Vigil Station - AI-Powered Ground Station Scheduling Assistant",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo:record": "bunx playwright test --config=playwright.config.js",
    "demo:record:headless": "DISPLAY= bunx playwright test --config=playwright.config.js --headed=false"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "leaflet": "1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^5.0.11",
    "vitest": "^4.1.10"
  }
}
